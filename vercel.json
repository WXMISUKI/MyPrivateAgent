{
  "version": 2,
  "builds": [
    {
      "src": "frontend-vue/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://myprivateagent.onrender.com/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend-vue/dist/$1"
    }
  ]
}
