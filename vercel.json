{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend-vue && npm install && npm run build",
  "outputDirectory": "frontend-vue/dist",
  "env": {
    "PYO3_USE_ABI3_FORWARD_COMPATIBILITY": "1"
  },
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@4.3.0",
      "maxDuration": 60,
      "excludeFiles": "{frontend-vue/**,docs/**,examples/**,skill_store/**,tests/**,openspec/**,.git/**,.github/**,.codex/**,.docker/**,.myagent/**,.pytest_cache/**,.tmp/**,问题记录/**}"
    },
    "api/[...path].py": {
      "runtime": "@vercel/python@4.3.0",
      "maxDuration": 60,
      "excludeFiles": "{frontend-vue/**,docs/**,examples/**,skill_store/**,tests/**,openspec/**,.git/**,.github/**,.codex/**,.docker/**,.myagent/**,.pytest_cache/**,.tmp/**,问题记录/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
